{
  "name": "cli-agent-ts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:orchestrator": "node dist/orchestrator.js",
    "start:cli": "node dist/cli_client/cli_client.js",
    "dev:orchestrator": "tsx src_ts/orchestrator.ts",
    "dev:cli": "tsx src_ts/cli_client/cli_client.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "build:weather-image": "docker build -t weather-server:test -f src_ts/cli_server/weather_ts_server/Dockerfile ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@google/genai": "^0.7.0",
    "dockerode": "^4.0.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.3.3",
    "openai": "^5.13.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.10.0",
    "tsx": "^4.20.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
